{
  "name": "loupe-desktop",
  "productName": "Loupe",
  "version": "0.17.1",
  "description": "Loupe for macOS: every project you've opened Loupe in, each canvas in a tab, connected to Claude Code.",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "npm --prefix ../app run build && electron .",
    "dist": "npm --prefix ../app run build && electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.ellioteriksson.loupe",
    "productName": "Loupe",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "tabbar.html",
      "tabbar-preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "loupe/server"
      },
      {
        "from": "../scripts",
        "to": "loupe/scripts"
      },
      {
        "from": "../app/dist",
        "to": "loupe/app/dist"
      },
      {
        "from": "../.claude-plugin/plugin.json",
        "to": "loupe/.claude-plugin/plugin.json"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "publish": null
  }
}
